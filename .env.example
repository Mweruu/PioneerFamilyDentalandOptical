# ---------------------------------------------------------------------------
# Pioneer Family Dental and Optical Clinic
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Absolute URL used in password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SMS notifications (Africa's Talking)
# Leave blank to record notifications as "not_configured" instead of sending.
# ---------------------------------------------------------------------------
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# ---------------------------------------------------------------------------
# Email notifications (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Supabase deployment
# Required. The publishable (anon) key is safe to ship to the browser; every
# query is still authorised by PostgreSQL Row Level Security.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Only needed for privileged auth operations (creating staff users
# from the admin UI). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
