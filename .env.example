# ---------------------------------------------------------------------------
# Pioneer Family Dental and Optical Clinic
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Absolute URL used in password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SMS notifications (Africa's Talking)
# Leave blank to record notifications as "not_configured" instead of sending.
# ---------------------------------------------------------------------------
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# ---------------------------------------------------------------------------
# Email notifications (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# ---------------------------------------------------------------------------
# WhatsApp reminders (Meta WhatsApp Cloud API)
# Business-initiated messages must use an approved template. The template body
# must use these positional parameters in order:
#   {{1}} patient name, {{2}} department, {{3}} clinic name, {{4}} date,
#   {{5}} time, {{6}} clinician, {{7}} reference, {{8}} clinic phone
# Example body:
#   Hello {{1}}, this is a reminder of your {{2}} appointment at {{3}} on
#   {{4}} at {{5}} with {{6}}. Reference {{7}}. Call {{8}}.
# Leave blank to record reminders as "not_configured".
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=appointment_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0

# ---------------------------------------------------------------------------
# Scheduled reminders (Vercel Cron)
# Required for /api/cron/reminders. Vercel sends this value as a Bearer token.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Supabase deployment
# Required. The publishable (anon) key is safe to ship to the browser; every
# query is still authorised by PostgreSQL Row Level Security.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional for the admin UI, required for the scheduled reminder job (it must
# read appointments across both departments). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
