# ---------------------------------------------------------------------------
# Pioneer Family Dental and Optical Clinic
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Session signing key for the local SQLite deployment.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Absolute URL used in password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: override the SQLite database location.
# CLINIC_DB_PATH=C:\path\to\clinic.db

# ---------------------------------------------------------------------------
# SMS notifications (Africa's Talking)
# Leave blank to record notifications as "not_configured" instead of sending.
# ---------------------------------------------------------------------------
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# ---------------------------------------------------------------------------
# Email notifications (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Supabase deployment blueprint (see supabase/migrations)
# These are only required if you migrate the demo from SQLite to Supabase.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
